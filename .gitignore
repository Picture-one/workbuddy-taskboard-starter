# ---- 私密配置（最高优先级，手滑 git add -A 也带不上）----
**/config.json
!**/config.example.json
# 本机私有字面量清单（扫描器用它抓自己人的隐私，本身必然含真实值）
scan-secrets.local.json

# ---- 运行态 ----
**/state/
logs/
install.log
.starter-manifest.json
_verify/
*.log
*.tmp
__pycache__/
*.pyc

# ---- 上游构建产物 / 依赖 ----
node_modules/
dist/
.data/
.wrangler/
.dev.vars*

# ---- 本机备份 / 残件 ----
*.bak-*
*.removed-*

# ---- 看板源码（board/）专属规则 ----
# 这些是本机产物/残件，绝不应入库。规则刻意限定在 board/ 下，
# 以免影响 references/setup/ 里的 *.cmd.tpl 模板与 *.rendered.txt 快照。
board/**/node_modules/
board/**/dist/
board/**/.data/
board/**/.wrangler/
board/**/.tmp/
board/**/logs/
board/**/*.log
board/**/*.err
board/**/*.bak-*
board/**/*.removed-*
board/**/*.retired-*
# 本机启动/自检脚本：装了本机绝对路径与真实主机名
board/**/*.cmd
board/**/*.pyw
# 本机备份的源码目录（如 web/src.bak-<时间戳>/）
board/**/src.bak-*/
board/**/*.tsbuildinfo
